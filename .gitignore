# built artifacts — do not commit stray build outputs (compile locally per README)
ugreen_leds_cli
*.txz
# dashboard binary compiled by src/panel/build.sh (CI builds it per release)
/src/panel/panel_dash
# exception: prebuilt/ holds the intentional, verified disaster-recovery copies
!prebuilt/ugreen_leds_cli
!prebuilt/*.txz
# release artifacts (published to the GitHub release, not committed; *.txz already
# excluded above). Built by release/mkpayload.sh.
release/*.sha256
# logs / runtime
*.log
*.pid
# never commit secrets
.env
# SSH keys / credentials used to deploy test builds to a box — these must never
# reach the repo. Broad on purpose: a private key is one `git add -A` away from a
# public push, so match by name AND by the conventional extensions.
id_rsa
id_ecdsa
id_ed25519*
*.pem
*.key
*_rsa
*_ed25519
/unraid
# macOS cruft
.DS_Store
